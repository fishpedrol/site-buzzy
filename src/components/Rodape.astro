---
import Marca from "./Marca.astro";
import { repositorio } from "../lib/release";
import { transicaoDeCor } from "../lib/estilos";
---

<footer class="text-cream bg-surface-footer" data-fundo="escuro">
  <div class="section-wrap flex min-h-94 items-center gap-30 celular:min-h-82 celular:gap-12 estreito:flex-wrap estreito:py-14">
    <Marca local="rodape" />
    <p class="m-0 text-footer-text text-[11px] estreito:order-2 estreito:w-full">
      Projeto pessoal, feito por diversão.
    </p>
    <a
      class={`inline-flex items-center gap-8 py-14 -my-14 ml-auto text-gold-light text-[12px] font-bold hover:text-cream ${transicaoDeCor}`}
      href={repositorio}>GitHub <span aria-hidden="true">↗</span></a
    >
  </div>
  <div
    class="flex min-h-38 items-center justify-between gap-20 px-[max(32px,calc((100%-var(--page-width))/2))] border-t border-cream/13 text-footer-meta font-mono text-[9px] leading-none tracking-[0.09em] celular:px-20 estreito:text-[8px]"
  >
    <span>UM PEQUENO AMIGO, FEITO DE PIXELS.</span><a class={`flex-none py-10 -my-10 font-body text-gold-light text-[10px] hover:text-cream ${transicaoDeCor}`} href="#topo"
      >VOLTAR AO TOPO <span aria-hidden="true">↑</span></a
    >
  </div>
</footer>
