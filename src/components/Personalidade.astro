---
import { caminho } from "../lib/caminho";
import { rotulo, tamanhoDoTitulo, tituloDeSecao } from "../lib/estilos";

// A prancha já traz o nome desenhado sob cada cara; o alt lista as 14, na ordem da imagem.
const expressoes = [
  "neutro", "feliz", "rindo", "curioso", "surpreso", "assustado", "sonolento",
  "bocejando", "dormindo", "travesso", "entediado", "pensativo", "empolgado", "determinado",
];
---

<section class="border-y-2 border-ink text-cream bg-navy" aria-labelledby="personality-title" data-fundo="escuro">
  <div
    class="section-wrap grid min-h-460 grid-cols-[0.8fr_1.2fr] items-center gap-[clamp(45px,9vw,128px)] py-81 celular:grid-cols-1 celular:gap-34 celular:py-64"
  >
    <div>
      <p class={`${rotulo} mb-19 text-gold-light text-[12px]`}>02 / PERSONALIDADE</p>
      <h2 class={`${tituloDeSecao} ${tamanhoDoTitulo} mb-22`} id="personality-title">
        Expressivo,<br /><span class="text-gold-light">sem dizer nada.</span>
      </h2>
      <p class="max-w-420 mb-24 text-on-navy text-[16px] leading-[1.65] celular:max-w-530">
        Curioso, sonolento, animado. Buzzy conta o que está sentindo com o jeito de se mexer e as caras que faz.
      </p>
      <a class="group/link inline-flex items-center gap-9 py-13 -my-13 text-gold-light text-[13px] font-bold hover:text-cream transition-[color] duration-160 ease-[ease]" href="#privacidade"
        >E ele respeita seu espaço <span
          class="transition-[translate] duration-160 ease-[ease] group-hover/link:translate-x-3"
          aria-hidden="true">→</span
        ></a
      >
    </div>
    <div class="min-w-0 p-13 border-2 border-ink bg-surface-neutral shadow-[7px_7px_0_var(--color-red)] celular:p-9">
      <div class="flex justify-between mb-9 text-brand font-mono font-bold text-[10px] leading-none tracking-[0.06em]">
        <span>HUMOR EM PIXELS</span><span class="text-red" aria-hidden="true">▧ ▧ ▧</span>
      </div>
      <img
        class="w-full max-h-184 object-contain pixelated celular:max-h-none"
        src={caminho("assets/expressoes.png")}
        alt={`Prancha com as ${expressoes.length} expressões do Buzzy, em duas fileiras: ${expressoes.slice(0, -1).join(", ")} e ${expressoes.at(-1)}.`}
        width="2320"
        height="578"
        loading="lazy"
      />
      <p class="mt-7 mb-0 text-legend font-mono text-[11px] leading-[1.3]" aria-hidden="true">
        {expressoes.length} caras, do {expressoes[0]} ao {expressoes.at(-1)}.
      </p>
    </div>
  </div>
</section>
